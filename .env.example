# 后台管理前端环境变量示例
# 复制为 .env.development / .env.production 后按需修改

# 服务端地址（开发默认直连本地 NestJS）
VITE_BHGT_SERVER_URL=http://localhost:4001

# 资源基础地址（OSS / CDN 域名 + bucket 前缀）。
# 后台填写 CG / 图片时只存相对路径，拼接此地址得到完整 URL，
# 换域名/切 CDN 时只改这里即可，无需改数据库。
VITE_BHGT_ASSET_BASE_URL=https://oss-cn-beijing.aliyuncs.com/bhgt-public-files
