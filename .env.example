# 后台管理前端环境变量示例
# 复制为 .env.development / .env.production 后按需修改

# 服务端地址（开发默认直连本地 NestJS）
VITE_BHGT_SERVER_URL=http://localhost:4001

# OSS 资源域名（三级域名 bucket.endpoint 形式）。
# 后台填写 CG / 图片时只存相对路径，拼接此域名得到完整 URL，
# 换 OSS / CDN 域名时只改这里即可，无需改数据库。
VITE_BHGT_OSS_DOMAIN=https://bhgt-public-files.oss-cn-beijing.aliyuncs.com
